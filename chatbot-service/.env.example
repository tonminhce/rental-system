MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.5
GOONG_API_KEY=
RENTAL_API_URL=http://127.0.0.1:8100/api
CORS_ORIGIN=http://localhost:4000,http://127.0.0.1:4000
# Same value as the backend's TOKEN_SECRET. Enables per-user thread ownership
# and rate limiting for requests carrying "Authorization: Bearer <access token>".
# Leave unset for anonymous (capability-URL) mode.
TOKEN_SECRET=
