NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8100
APP_PREFIX=api
DB_PORT=3307
DB_HOST_READ=127.0.0.1
DB_HOST_WRITE=127.0.0.1
DB_USER=rentalk
DB_PASSWORD=rentalk_local_only
DB_NAME=rentalk_local
CORS_ORIGIN=http://localhost:4000,http://127.0.0.1:4000
# REQUIRED — the backend refuses to boot if either is missing or if the two
# are identical. Generate separate values, e.g.: openssl rand -hex 32
# Never reuse local secrets for deployment.
TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Password the local seeders give their demo accounts. Leave unset and each
# seed run mints its own and prints it; set it to the same value as
# RENTAL_API_PASSWORD in the crawlers that sign in as a demo account.
SEED_DEMO_PASSWORD=
